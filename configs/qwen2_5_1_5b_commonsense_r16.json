  "decisions": [
    {"id": "scope", "status": "confirmed", "proposal": "第一轮仅做8项commonsense任务的Full/Random8/Adaptive8；暂不做math、LoRA+或DoRA。"},
    {"id": "prompt", "status": "confirmed", "proposal": "统一规范化Alpaca纯文本前缀，不使用Qwen chat/system模板；校准和生成只接instruction/input，不接答案。"},
    {"id": "supervision", "status": "confirmed", "proposal": "只监督答案及显式EOS；整条序列右截断到512，截断后没有可预测监督token即报错，不静默丢弃或重抽。"},
    {"id": "sampling", "status": "confirmed", "proposal": "训练抽10000条，再从该子集抽250条校准；各评估test抽1000条、OBQA500条；分别使用局部seed42并保存实际索引与身份哈希。"},
    {"id": "answer_parser", "status": "confirmed", "proposal": "仅解析生成续文；标签大小写不敏感且有词边界，不同标签冲突判无效，解析失败仍计入分母；8任务等权宏平均。"},
    {"id": "single_gpu_batch", "status": "confirmed", "proposal": "单卡micro-batch8、accumulation8，有效batch64；明确不同于论文4卡DDP的256，显存不足时停下申请配置变更。"},
    {"id": "mirror_source", "status": "confirmed", "proposal": "官方HF端点不可达；候选模型版本及LFS哈希来自镜像，后续下载核对固定字节，保留未独立认证官方来源的局限。"}
